# "development" allows the built-in JWT secret; "production" refuses to start without a real one.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://ledger:ledger@127.0.0.1:5433/ledger
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Optional in development (a built-in dev key is used); required in production.
# JWT_SECRET=
