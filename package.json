{
  "name": "daily-expense-tracker",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:api": "cd backend && .venv/Scripts/fastapi dev app/main.py --port 8010",
    "db:up": "docker compose up -d db",
    "db:migrate": "cd backend && .venv/Scripts/alembic upgrade head",
    "test:api": "cd backend && .venv/Scripts/python -m pytest -q",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
